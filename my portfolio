* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;

    background: linear-gradient(
        135deg,
        #667eea,
        #764ba2
    );

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;
}

.app-container {
    width: 100%;
    max-width: 650px;

    background-color: white;

    border-radius: 18px;

    padding: 30px;

    box-shadow:
        0 15px 40px rgba(0, 0, 0, 0.2);
}

/* Header */

.app-header {
    text-align: center;
    margin-bottom: 25px;
}

.app-header h1 {
    font-size: 32px;
    margin-bottom: 8px;
}

.app-header p {
    color: #666;
}

/* Input area */

.task-input-section {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
}

#taskInput {
    flex: 1;

    padding: 14px;

    border: 2px solid #ddd;
    border-radius: 8px;

    font-size: 16px;

    outline: none;
}

#taskInput:focus {
    border-color: #667eea;
}

#addTaskButton {
    border: none;

    padding: 14px 20px;

    background-color: #667eea;
    color: white;

    border-radius: 8px;

    cursor: pointer;

    font-size: 15px;
}

#addTaskButton:hover {
    background-color: #5368d5;
}

/* Summary */

.task-summary {
    display: flex;
    justify-content: space-between;

    gap: 12px;

    margin-bottom: 30px;
}

.summary-box {
    flex: 1;

    text-align: center;

    padding: 15px;

    background-color: #f4f5ff;

    border-radius: 10px;
}

.summary-box span {
    display: block;

    font-size: 25px;

    font-weight: bold;

    color: #667eea;
}

.summary-box small {
    color: #666;
}

/* Task section */

.task-list-section h2 {
    margin-bottom: 15px;
}

#taskList {
    list-style: none;
}

/* Individual task */

.task-item {
    display: flex;

    align-items: center;

    gap: 12px;

    padding: 15px;

    margin-bottom: 10px;

    background-color: #f8f8f8;

    border-radius: 10px;

    border-left: 5px solid #667eea;
}

.task-text {
    flex: 1;

    font-size: 16px;

    word-break: break-word;
}

.completed .task-text {
    text-decoration: line-through;

    color: #999;
}

/* Complete button */

.complete-button {
    border: none;

    background-color: #28a745;

    color: white;

    padding: 8px 12px;

    border-radius: 6px;

    cursor: pointer;
}

.complete-button:hover {
    background-color: #218838;
}

/* Delete button */

.delete-button {
    border: none;

    background-color: #dc3545;

    color: white;

    padding: 8px 12px;

    border-radius: 6px;

    cursor: pointer;
}

.delete-button:hover {
    background-color: #c82333;
}

/* Empty message */

#emptyMessage {
    text-align: center;

    color: #888;

    padding: 25px;

    display: block;
}

/* Mobile design */

@media (max-width: 600px) {

    .app-container {
        padding: 20px;
    }

    .task-input-section {
        flex-direction: column;
    }

    #addTaskButton {
        width: 100%;
    }

    .task-summary {
        flex-direction: column;
    }

    .task-item {
        flex-wrap: wrap;
    }

    .task-text {
        width: 100%;
    }
}

// ================= MOBILE MENU =================

const menuBtn = document.querySelector(".menu-btn");
const navLinks = document.querySelector(".nav-links");

menuBtn.addEventListener("click", function () {

    navLinks.classList.toggle("active");

});


// Close menu after clicking a link

const links = document.querySelectorAll(".nav-links a");

links.forEach(function(link) {

    link.addEventListener("click", function() {

        navLinks.classList.remove("active");

    });

});


// ================= CONTACT FORM =================

const form = document.getElementById("contactForm");

form.addEventListener("submit", function(event) {

    event.preventDefault();

    const name = document.getElementById("name").value;

    const message =
        document.getElementById("formMessage");

    message.innerText =
        "Thank you, " + name +
        "! Your message has been received. 🚀";

    form.reset();

});


